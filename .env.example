# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit your real .env file.

# --- Database -----------------------------------------------------------
# Full connection string the app uses. When running via docker-compose,
# the host must be "postgres" (the compose service name) and the password
# must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://radtempo:changeme@postgres:5432/radtempo
# Password for the postgres service's "radtempo" role (docker-compose only).
POSTGRES_PASSWORD=changeme
# Separate database used only by the test suite (`pnpm test:integration`).
# Not used by docker-compose; only relevant for local development.
DATABASE_URL_TEST=postgres://radtempo:radtempo@localhost:5432/radtempo_test

# --- Auth -----------------------------------------------------------------
# Secret used to sign sessions/cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=changeme-generate-a-real-32-byte-secret
# The public base URL this instance is served at (used for auth callbacks,
# invite/reset links, and CORS/origin checks).
APP_URL=http://localhost:3000

# --- Registration -----------------------------------------------------------
# "invite_only" (default) or "open". Admins can change this later in the
# admin UI; this env var only sets the initial value on first boot.
REGISTRATION_MODE=invite_only
# Optional: if set and no users exist yet, an admin account is created
# automatically at startup instead of requiring the /setup wizard. Remove
# INITIAL_ADMIN_PASSWORD from .env after the first successful start.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Required to use the interactive /setup wizard (path A below). Generate
# with: openssl rand -base64 32. Never commit a real value. Without this
# AND without INITIAL_ADMIN_EMAIL/PASSWORD set, initial setup is impossible
# (the app fails closed rather than letting anyone claim the first account).
SETUP_TOKEN=

# --- SMTP (optional) ---------------------------------------------------
# Leave all SMTP_* unset to run without email: sign-in/accounts still work,
# and admins can create users / reset credentials manually. Set SMTP_HOST to
# enable password reset emails, email verification, and emailed invites.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="RadTempo <no-reply@example.com>"
# Require a verified email before a user can sign in. Only meaningful when
# SMTP is configured.
EMAIL_VERIFICATION_REQUIRED=false

# --- Telemetry (optional, off by default) --------------------------------
# Anonymous, instance-level only (app version, feature flags, aggregate
# counts, error categories). Never emails, user IDs, study data, or IPs.
TELEMETRY_ENABLED=false
# Where to send telemetry. If unset, nothing is ever sent even if enabled.
TELEMETRY_ENDPOINT=

# --- Reverse proxy / domain (optional) -----------------------------------
# Only used by docker-compose.caddy.yml, for automatic HTTPS.
DOMAIN=
# Host port the app is published on when NOT using the bundled Caddy proxy.
APP_PORT=3000
